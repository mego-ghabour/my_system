// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db" // Using SQLite for easy setup
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  avatarUrl String?
  geminiKey String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id               String   @id @default(cuid())
  name             String
  phone            String   @unique // WhatsApp number
  email            String?
  companyName      String?
  taxId            String?
  address          String?
  notes            String?
  status           String   @default("ACTIVE") // ACTIVE, INACTIVE, LEAD, VIP
  isPinned         Boolean  @default(false)
  walletBalance    Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  stores             Store[]
  documents          ClientDocument[]
  accounts           ClientAccount[]
  services           ClientService[]
  invoices           Invoice[]
  quotations         Quotation[]
  tasks              Task[]
  tickets            Ticket[]
  activities         ClientActivity[]
  walletTransactions WalletTransaction[]
  contracts          Contract[]
}

model ClientActivity {
  id          String   @id @default(cuid())
  clientId    String
  type        String   // e.g., CLIENT_CREATED, INVOICE_CREATED, STORE_ADDED, etc.
  description String
  createdAt   DateTime @default(now())

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ClientDocument {
  id        String   @id @default(cuid())
  clientId  String
  storeId   String?  // Optional link to a specific store
  name      String   // e.g. "Commercial Register", "ID"
  fileUrl   String   // File path or url
  type      String   // File type e.g. "PDF", "IMAGE"
  createdAt DateTime @default(now())

  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  store     Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model ClientAccount {
  id        String   @id @default(cuid())
  clientId  String
  storeId   String?  // Optional link to a specific store
  name      String   // e.g. "Tabby", "Tamara", "Gmail", "Cartat", "Torod"
  username  String?  // Username, Email, or Phone
  password  String?
  link      String?
  createdAt DateTime @default(now())

  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  store     Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model Store {
  id               String   @id @default(cuid())
  clientId         String
  name             String   @default("متجر جديد") // Store Name
  storeLink        String?
  platformName     String?  // e.g. Salla, Zid
  platformEmail    String?
  platformPassword String?
  createdAt        DateTime @default(now())

  client           Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  accounts         ClientAccount[]
  documents        ClientDocument[]
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  basePrice   Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clients     ClientService[]
}

model ClientService {
  id        String   @id @default(cuid())
  clientId  String
  serviceId String
  status    String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  price     Float    // Agreed price for this specific client
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model Invoice {
  id        String   @id @default(cuid())
  clientId  String
  total     Float
  paid      Float    @default(0)
  dueDate   DateTime?
  status    String   @default("UNPAID") // UNPAID, PARTIAL, PAID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  payments  Payment[]
  items     InvoiceItem[]
}

model InvoiceItem {
  id        String   @id @default(cuid())
  invoiceId String
  title     String
  price     Float
  
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Float
  date      DateTime @default(now())
  notes     String?
  
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Quotation {
  id        String   @id @default(cuid())
  clientId  String
  total     Float
  status    String   @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items     QuotationItem[]
}

model QuotationItem {
  id          String   @id @default(cuid())
  quotationId String
  title       String
  price       Float
  
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model Ticket {
  id          String   @id @default(cuid())
  clientId    String
  title       String
  description String
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Task {
  id        String   @id @default(cuid())
  clientId  String?
  title     String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
}

model Asset {
  id        String   @id @default(cuid())
  name      String   // e.g. "Commercial Register"
  type      String   // "DOCUMENT", "IMAGE", "TEXT"
  content   String   // File path or text content (like IBAN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model PlatformOption {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model WalletTransaction {
  id        String   @id @default(cuid())
  clientId  String
  amount    Float
  type      String   // "CREDIT" (deposit), "DEBIT" (deduction)
  notes     String?
  createdAt DateTime @default(now())

  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Contract {
  id            String    @id @default(cuid())
  clientId      String
  title         String    // عنوان العقد (مثلا: اتفاقية إنشاء وتجهيز متجر سلة)
  content       String    // بنود وشروط العقد
  totalAmount   Float     @default(0)
  status        String    @default("PENDING") // PENDING (بانتظار التوقيع), SIGNED (تم التوقيع)
  signatureData String?   // صورة التوقيع الإلكتروني Base64
  signerName    String?   // اسم الموقع
  signedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
}


